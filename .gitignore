# ============================================================
#  projectTP (HD-2D PvP ATB) — .gitignore
#  Repo root = D:\unreal  (workspace: engine + project + resources)
# ============================================================

# ===== Unreal Engine build (~31 GB) — NEVER commit =====
/UE_5.8/

# ===== Unreal project: generated / transient =====
/projectTP/Binaries/
/projectTP/Build/
/projectTP/DerivedDataCache/
/projectTP/Intermediate/
/projectTP/Saved/
/projectTP/.vs/
/projectTP/*.sln
/projectTP/*.VC.db
/projectTP/*.VC.opendb
/projectTP/*.opensdf
/projectTP/*.sdf
/projectTP/*.suo

# ===== PAID asset pack ORIGINALS — redistribution prohibited on PUBLIC repo =====
# 유료 구매팩 원본은 이 공개 저장소에 절대 올리지 않는다(재배포 금지 라이선스).
# 대신 별도 비공개 저장소로 백업: github.com/LeeJuls/ProjectTP-Resource-Assets (Git LFS)
#   → _RawAssets/ 자체가 그 저장소의 워킹트리다(중첩 repo, Content/ 방식과 동일).
#   → heroes99(캐릭터) · vfx(VFX팩) · tilesets(Winlu) · ui-packs(Pixel UI) 수용
#   ★새 유료팩은 Resource 아무 데나 두지 말고 반드시 _RawAssets/ 아래에 둘 것.
/Resource/_RawAssets/
/Resource/*.zip

# ===== UE Content — imported assets (incl. paid Fab packs) + heavy; reproduce via docs/scripts =====
/projectTP/Content/

# ===== 서드파티 UE 플러그인 (오픈소스 클론 — 재현: git clone + UBT 빌드, 절차는 docs/언리얼_MCP_실전노하우.md) =====
/projectTP/Plugins/UmgMcp/
# TAPython (재현: GitHub cgerchenhp/UE_TAPython_Plugin_Release v1.3.3-ue5.8.0 zip 압축해제)
/projectTP/Plugins/TAPython/
# TAPython 런타임 산출 폴더(에디터 생성)
/projectTP/TA/

# ===== Blend / large source files =====
/Resource/*.blend

# ===== Playwright temp snapshots =====
/Resource/.playwright-mcp/

# ===== UE auto-generated project copies (e.g. "projectTP 5.8") =====
/projectTP */

# ===== 단계별 롤백용 UE 애셋 스냅샷 (로컬 전용 — .uasset은 git 대상 아님) =====
/_savepoints/

# ===== Local tooling / editor state =====
**/.claude/settings.local.json
/Resource/docs/.obsidian/workspace.json
/Resource/docs/.obsidian/workspace-mobile.json
/Resource/docs/.obsidian/cache
# 서드파티 플러그인 코드(5.7MB). 2026-08-11 `git add -A`로 28,668줄이 문서 커밋에
# 혼입되는 사고가 있었다. 플러그인 "목록"(community-plugins.json)은 추적하되
# 코드 자체는 각자 Obsidian이 재설치한다.
/Resource/docs/.obsidian/plugins/

# ===== Python bytecode cache (docs/scripts 파이썬 도구들 — LOG-A battle_log 패키지 등) =====
__pycache__/
*.pyc

# ===== projectCB — 별개 게임, 별개 저장소 (오너 확정 2026-08-13) =====
#   포커 1:1 PvP. projectTP와 다른 게임이므로 이력을 섞지 않는다.
#   D:\unreal\ProjectCB\ 자체가 그 저장소의 워킹트리다
#   (중첩 repo — Content/ · _RawAssets/ 와 동일 방식으로 부모가 통째로 ignore).
#   ★이 저장소(ProjectTP)에서는 ProjectCB를 절대 추적하지 않는다.
#   배치 규약: ProjectCB/docs/guides/저장소_구조_규약.md
/ProjectCB/

# ===== ★압축파일 전역 차단 (2026-08-13 신설) =====
#   사고 이력: `Pixel UI pack 3.rar`(2026-07-26)가 공개 저장소 추적 대상으로 방치됐고,
#   `Pixel Classic Cards.rar`(2026-08-13)가 저장소 루트에 방치됐다. 둘 다 확장자 규칙이
#   경로별(/Resource/*.zip)로만 있어서 다른 경로는 뚫려 있었다. 이제 위치 무관 차단한다.
#   ★압축 해제 원본이 필요하면 _RawAssets/ 아래(비공개 대상)에 둔다.
*.rar
*.7z
*.zip
*.aseprite

# ===== OS junk =====
Thumbs.db
Desktop.ini
.DS_Store
*.tmp

# (구 /Resource/vfx/ 제외 규칙은 2026-07-26 _RawAssets/vfx/ 로 이관되어 삭제됨)
